PORT=5000

# MySQL example
DB_DIALECT=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=dms_db
DB_PORT=3306

# PostgreSQL alternative
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me
SUPER_ADMIN_NAME=Super Admin
ENABLE_LICENSE_SYSTEM=false
ENABLE_SUPER_ADMIN_MANAGER_ROLES=false
ENABLE_ADMIN_MANAGER_ROLES=true
ENABLE_DEALER_MANAGER_ROLES=true
ENABLE_DEALER_STOCK_EXCHANGE=true
ENABLE_FORGOT_PASSWORD_OTP=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_app_password
MAIL_FROM=your_email@example.com
